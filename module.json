		"pf2e-agents-of-the-old-world": {
			"pf2e-homebrew": {
				"featTraits": {
					"aether": "Aether",
					"crystal": "Crystal",
					"saga": {
						"label": "Saga",
						"description": "Sagas function similarly to stances, entering them as an action and remaining in them until you get knocked out, you enter a different saga, or you fail to sustain the saga, whichever comes first. You cannot sustain a saga by using the Sustain action; instead, a saga is automatically Sustained the first time each round you Cast or Sustain a spell with the composition trait or damage an enemy with a Strike. This section describes the sagas you can access as a skald. Their entries provide the following information. Sagas can be used out of combat, requiring you to use the Sustain an Effect exploration activity; you perform a composition cantrip to sustain the effect instead of using the Sustain action."
					},
					"sound": "Sound"
				},
				"weaponTraits": {
					"werecreature": "Werecreature"
				}
			}
		}
